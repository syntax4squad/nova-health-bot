SECRET_KEY=change-this-to-a-long-random-string
# Groq API key ->https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

GROQ_MODEL=openai/gpt-oss-120b

DATABASE_URL=sqlite:///instance/swasthyasaathi.db

ADMIN_EMAIL=admin@swasthyasaathi.local
ADMIN_PASSWORD=change-this-admin-password

# Set to "1" to enable Flask debug mode (never use in production)
FLASK_DEBUG=1


#   serper      -> https://serper.dev            
#   serpapi     -> https://serpapi.com        
#   google_cse  -> https://programmablesearchengine.google.com   
#   duckduckgo  -> no signup needed at all (used automatically as the fallback)
#   none        -> disable live search entirely (local knowledge base only)
SEARCH_PROVIDER=auto

SERPER_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=


FACT_CHECK_MAX_CLAIM_LENGTH=2000


FACT_CHECK_MAX_SEARCH_RESULTS=8


FACT_CHECK_CACHE_TTL=21600



FACT_CHECK_MIN_TRUSTED_SOURCES=2

# Set to "0" to force the fact-checker to skip live web search entirely,
FACT_CHECK_ENABLE_LIVE_SEARCH=1

# Max fact-check requests allowed per IP per rolling 60 seconds
FACT_CHECK_RATE_LIMIT_PER_MIN=6
